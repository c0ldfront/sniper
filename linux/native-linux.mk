CC ?= cc
CFLAGS ?= -std=c11 -O2 -Wall -Wextra -Werror
SDL_CFLAGS := $(shell pkg-config --cflags sdl2)
SDL_LIBS := $(shell pkg-config --libs sdl2)
BUILD := build/native
# Generated by `make -C .. assets` (tools/extract_assets.py); never committed.
ASSETS ?= ../build/assets
SRC := $(wildcard ../src/*.c)
OBJ := $(patsubst ../src/%.c,$(BUILD)/%.o,$(SRC))
.PHONY: all clean
all: $(BUILD)/sniper87-native
$(BUILD):
	mkdir -p $@
$(BUILD)/%.o: ../src/%.c | $(BUILD)
	$(CC) $(CFLAGS) -Isrc -I../src -c $< -o $@
$(BUILD)/sniper_assets.o: $(ASSETS)/sniper_assets.c ../include/sniper_assets.h | $(BUILD)
	$(CC) $(CFLAGS) -I../include -c $< -o $@
$(ASSETS)/sniper_assets.c:
	@echo "missing $@: run 'make -C .. assets SNIPER_ZIP=/path/to/sniper87.zip' first" >&2; exit 1
$(BUILD)/sniper87-native: native_client.c $(OBJ) $(BUILD)/sniper_assets.o | $(BUILD)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -I../src -I../include $< $(OBJ) $(BUILD)/sniper_assets.o $(SDL_LIBS) -lm -o $@
clean:
	rm -rf $(BUILD)
