CC = i686-w64-mingw32-gcc
WINDRES = i686-w64-mingw32-windres
# Generated by `make -C .. assets` (tools/extract_assets.py); never committed.
ASSETS ?= ../build/assets
CFLAGS = -std=c11 -O2 -g -Wall -Wextra -Werror
.PHONY: all clean
all: build/sniper87-recreated.exe build/LICENSE.TXT build/sprite_surface.o build/ship_painter.o build/map_painter.o build/viewport.o build/palette_resource.o build/overlay_painter.o build/projectile_painter.o build/actor_painter.o
build:
	mkdir -p $@
$(ASSETS)/sniper_assets.rc:
	@echo "missing $@: run 'make -C .. assets SNIPER_ZIP=/path/to/sniper87.zip' first" >&2; exit 1
$(ASSETS)/files/%:
	@echo "missing $@: run 'make -C .. assets SNIPER_ZIP=/path/to/sniper87.zip' first" >&2; exit 1
build/resources.o: $(ASSETS)/sniper_assets.rc | build
	$(WINDRES) $< -O coff -o $@
build/LICENSE.TXT: $(ASSETS)/files/LICENSE.TXT | build
	cp $< $@
clean:
	rm -f build/resources.o build/sniper87-recreated.exe build/LICENSE.TXT

